{
    "name": "dsh-daily-coding-plugin",
    "version": "0.2.3",
    "type": "module",
    "main": "index.js",
    "exports": {
        ".": {
            "default": "./index.js"
        },
        "./client": {
            "default": "./client.js"
        }
    },
    "files": [
        "index.js",
        "tools.js",
        "storage.js",
        "date.js",
        "leetcode.js",
        "routes.js",
        "client.js",
        "cordis.patch.yml"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [
                "dsh-better-sidebar"
            ]
        }
    },
    "peerDependencies": {
        "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0"
    },
    "devDependencies": {
        "@deepseek-ai/dsh-tools": "0.2.1-alpha.3"
    }
}
